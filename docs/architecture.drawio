        <mxCell id="app" value="Desktop App  —  .venv312 / Python 3.7 (pinned by the CARLA egg)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;fontStyle=1;fontSize=14;spacingTop=4;" vertex="1" parent="1">
